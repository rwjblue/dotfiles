#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; -*-
#MISE description="Update AI coding tools (opencode, claude-code, codex, openspec, agent-browser)"

set -euo pipefail

script_path="$(realpath "${BASH_SOURCE[0]}")"
dotfiles_dir="$(cd "$(dirname "$script_path")/../../../.." && pwd -P)"
lock_paths=(root:packages/mise/mise.lock root:packages/mise/locks)
commit_subject="chore(mise): update AI tool lockfile"
upgrade_output_file="$(mktemp)"
trap 'rm -f "$upgrade_output_file"' EXIT

tools=(
  opencode
  claude-code
  npm:@openai/codex
  npm:@fission-ai/openspec
  npm:agent-browser
)

lock_changes_before=$(jj -R "$dotfiles_dir" diff --name-only "${lock_paths[@]}")
if [[ -n "$lock_changes_before" ]]; then
  echo "Skipping lockfile auto-commit: mise lock files were already dirty before up:ai"
fi

mise up --global "${tools[@]}" | tee "$upgrade_output_file"

upgraded_tools=()
while IFS= read -r upgraded_tool; do
  upgraded_tools+=("$upgraded_tool")
done < <(
  awk '
    /^Upgraded [0-9]+ tools:$/ { capture = 1; next }
    capture && /^  / { print $1 }
  ' "$upgrade_output_file"
)

if (( ${#upgraded_tools[@]} > 0 )); then
  mise lock --global "${upgraded_tools[@]}"
fi

lock_changes_after=$(jj -R "$dotfiles_dir" diff --name-only "${lock_paths[@]}")
if [[ -z "$lock_changes_before" && -n "$lock_changes_after" ]]; then
  upgrade_summary="$(
    awk '
      /^Upgraded [0-9]+ tools:$/ { capture = 1 }
      capture { print }
    ' "$upgrade_output_file"
  )"

  if [[ -n "$upgrade_summary" ]]; then
    commit_body=$'Record the global tool versions and npm dependency graphs together.\n\n'"$upgrade_summary"
  else
    commit_body="Record the global tool versions and npm dependency graphs together."
  fi

  echo "Auto-committing the global mise lock files with jj"
  jj -R "$dotfiles_dir" commit --quiet "${lock_paths[@]}" -m "$commit_subject"$'\n\n'"$commit_body"
elif [[ -z "$lock_changes_before" ]]; then
  echo "Skipping lockfile auto-commit: no mise lock files changed"
fi
