#!/usr/bin/env bash
#MISE description="Mirror agent skills into Cursor's synced skill store for Cloud Agents"
set -euo pipefail

# Read from the checkout ~/.agents/skills points at, not this one. Worktrees
# lack the private skills local-packages links in, and --delete below would
# remove them from the store.
src="$(cd "$HOME/.agents/skills" && pwd -P)"

store=$("$MISE_PROJECT_ROOT/packages/cursor/skills-store.sh")
if [ -z "$store" ]; then
  echo "No Cursor skill store found; skipping (is Sync Skills for Cloud Agents on?)"
  exit 0
fi

# Turning sync on moves ~/.cursor/skills into the store and trashes the
# originals, which would hit this repo through a symlink. Cursor already
# reads these skills locally from ~/.agents/skills and ~/.claude/skills.
if [ -L "$HOME/.cursor/skills" ]; then
  echo "removing symlink $HOME/.cursor/skills -> $(readlink "$HOME/.cursor/skills")"
  rm "$HOME/.cursor/skills"
fi

# Sync skips symlinks, so -L copies the private skills that local-packages
# links in. node_modules has made sync time out. --checksum skips rewriting
# unchanged files so they don't upload again.
mkdir -p "$store/skills"
rsync -rL --executability --checksum --delete \
  --exclude .gitignore \
  --exclude .DS_Store \
  --exclude node_modules \
  "$src/" "$store/skills/"

echo "Mirrored $(find "$store/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ') skills from $src"

CURSOR_SKILLS_STORE="$store" \
  CURSOR_SKILLS_SYNC_WAIT="${CURSOR_SKILLS_SYNC_WAIT:-120}" \
  "$MISE_PROJECT_ROOT/mise/tasks/cursor/skills-sync-status"
