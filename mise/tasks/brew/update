#!/usr/bin/env bash
#MISE description="Preview Brewfile differences against installed Homebrew packages"
set -euo pipefail

# macOS only
if [[ "$OSTYPE" != darwin* ]]; then
  exit 0
fi

snapshot_dir=$(mktemp -d)
trap 'rm -rf "$snapshot_dir"' EXIT
snapshot="$snapshot_dir/Brewfile"

brew bundle dump --file "$snapshot"

if diff -u -L Brewfile -L 'Installed Homebrew snapshot' "$MISE_PROJECT_ROOT/Brewfile" "$snapshot"; then
  echo "The Brewfile matches the installed Homebrew snapshot."
else
  status=$?
  # diff returns 1 for an ordinary difference.
  if (( status != 1 )); then
    exit "$status"
  fi
fi
